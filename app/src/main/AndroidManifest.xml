<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <application
        android:name=".CloneMasterApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.CloneMaster"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true"
        android:largeHeap="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CloneMaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.CloneConfigActivity" android:exported="false" />
        <activity android:name=".ui.CloneOptionsActivity" android:exported="false" android:theme="@style/Theme.CloneMaster" />
        <activity android:name=".ui.BuildProgressActivity" android:exported="false" android:theme="@style/Theme.CloneMaster" />
        <activity android:name=".ui.AppAnalyzerActivity" android:exported="false" />
        <activity android:name=".ui.ViewInspectorActivity" android:exported="false" />
        <activity android:name=".ui.LogcatViewerActivity" android:exported="false" />
        <activity android:name=".environment.EnvironmentDiagnosticsActivity" android:exported="false" />
        <activity android:name=".databundle.FirstRunImportActivity" android:exported="false" android:theme="@style/Theme.CloneMaster" />
        <activity android:name=".privacy.DecoyCalculatorActivity" android:exported="false" android:theme="@style/Theme.CloneMaster.Calculator" />
        <activity android:name=".privacy.PasswordGateActivity" android:exported="false" />

        <service android:name=".cloning.engine.CloneService" android:exported="false" android:foregroundServiceType="dataSync" />

        <service android:name=".networking.TunProxyService" android:exported="false" />

        <service android:name=".launching.PersistentCloneService" android:exported="false" android:foregroundServiceType="dataSync" />

        <receiver android:name=".launching.DialerLaunchReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="7777" />
            </intent-filter>
        </receiver>

        <receiver android:name=".launching.BootReceiver" android:exported="true" android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <receiver android:name=".networking.NotificationNetworkingToggle$ToggleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.clonemaster.TOGGLE_NETWORK" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
